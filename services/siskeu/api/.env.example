# SISKEU owns this database and is the only SPP invoice writer.
DATABASE_URL="postgresql://postgres:replace-me@localhost:5432/siskeu"

# Required for authenticated finance routes. Use the SSO JWKS URL or a private secret,
# plus the exact issuer/audience used by the SSO token issuer.
AUTH_JWKS_URL="https://auth.example.test/.well-known/jwks.json"
AUTH_JWT_ISSUER="https://auth.example.test"
AUTH_JWT_AUDIENCE="siskeu"

# Required by SIAKAD for server-to-server invoice reads and payment-session requests.
SISKEU_INTERNAL_SERVICE_TOKEN="replace-with-a-shared-high-entropy-token"

# Required before a payment URL can be returned. Both placeholders are URL-encoded.
SISKEU_PAYMENT_URL_TEMPLATE="https://payments.example.test/pay/{invoiceId}?reference={reference}"

# Required for the provider webhook endpoint; configure this from the real payment provider.
SISKEU_PROVIDER_WEBHOOK_TOKEN="replace-with-provider-webhook-token"
