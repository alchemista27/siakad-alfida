datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum ExecutionStatus {
  not_started
  in_progress
  completed
  delayed
  cancelled
}

enum VerificationStatus {
  unverified
  needs_revision
  verified
}

enum EvidenceType {
  document
  photo
  link
}

enum EvidenceNature {
  mandatory
  supporting
}

enum ExecutionPriority {
  critical
  high
  medium
  low
}

enum KPIIndicatorType {
  input
  process
  output
  outcome
}

enum KPIDirection {
  higher_is_better
  lower_is_better
  exact_match
}

enum KPIUpdateFrequency {
  weekly
  monthly
  quarterly
  semester
  yearly
}

enum WorkProgramStatus {
  planned
  ongoing
  completed
}

enum BaselineStatus {
  draft
  submitted
  under_review
  approved
  revision_needed
  locked
}

enum AttendanceStatus {
  present
  sick
  permitted
  absent
}

enum ReportType {
  weekly
  monthly
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(200)
  username  String?  @unique @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  avatarUrl String?  @map("avatar_url") @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  departmentAdmins    DepartmentAdmin[]
  departmentMembers   DepartmentMember[]
  departmentsLed      Department[]              @relation("DepartmentLeader")
  workProgramsAsPIC   WorkProgram[]             @relation("WorkProgramsPIC")
  programsCoordinated WorkProgram[]             @relation("WorkProgramsCoordinator")
  activityReports     ActivityReport[]          @relation("SubmittedActivityReports")
  kpisOwned           ExecutionKPI[]            @relation("ExecutionKPIPIC")
  milestonesOwned     ExecutionMilestone[]      @relation("MilestonePIC")
  tasksAssigned       ExecutionTask[]           @relation("TaskAssignee")
  tasksDelegated      ExecutionTask[]           @relation("TaskAssignor")
  tasksVerified       ExecutionTask[]           @relation("TaskVerifier")
  realizationLogs     ExecutionRealizationLog[] @relation("RealizationPIC")
  evidenceOwned       ExecutionEvidence[]       @relation("EvidenceOwner")
  evidenceVerified    ExecutionEvidence[]       @relation("EvidenceVerifier")
  reportedIssues      ExecutionIssue[]          @relation("IssueReporter")
  assignedIssues      ExecutionIssue[]          @relation("IssueAssignee")
  meetingAttendances  MeetingAttendance[]
  actionItems         ExecutionActionItem[]     @relation("ActionItemPIC")

  @@map("users")
}

model Department {
  id          String   @id @default(uuid()) @db.Uuid
  unitId      String?  @map("unit_id") @db.Uuid
  name        String   @db.VarChar(100)
  description String?
  notes       String?  @db.Text
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  parentId    String?  @map("parent_id") @db.Uuid
  leaderId    String?  @map("leader_id") @db.Uuid

  parent          Department?        @relation("DepartmentToDepartment", fields: [parentId], references: [id], onDelete: SetNull)
  children        Department[]       @relation("DepartmentToDepartment")
  leader          User?              @relation("DepartmentLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  admins          DepartmentAdmin[]
  members         DepartmentMember[]
  workPrograms    WorkProgram[]
  activityReports ActivityReport[]

  @@map("departments")
}

model DepartmentAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("department_admins")
}

model DepartmentMember {
  id           String   @id @default(uuid()) @db.Uuid
  departmentId String   @map("department_id") @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  role         String?  @db.VarChar(50)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@map("department_members")
}

model WorkProgram {
  id              String            @id @default(uuid()) @db.Uuid
  departmentId    String            @map("department_id") @db.Uuid
  academicYearId  String?           @map("academic_year_id") @db.Uuid
  userId          String?           @map("user_id") @db.Uuid
  title           String            @db.VarChar(255)
  description     String?           @db.Text
  source          String?           @db.VarChar(100)
  objective       String?           @db.Text
  targetAudience  String?           @map("target_audience") @db.VarChar(255)
  mainOutput      String?           @map("main_output") @db.Text
  expectedOutcome String?           @map("expected_outcome") @db.Text
  startDate       DateTime?         @map("start_date") @db.Date
  endDateRencana  DateTime?         @map("end_date_rencana") @db.Date
  coordinatorId   String?           @map("coordinator_id") @db.Uuid
  priority        ExecutionPriority @default(medium)
  budgetRef       String?           @map("budget_ref") @db.VarChar(255)
  manualProgress  Int?              @map("manual_progress") @db.SmallInt
  status          WorkProgramStatus @default(planned)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?         @updatedAt @map("updated_at") @db.Timestamptz

  department      Department                @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user            User?                     @relation("WorkProgramsPIC", fields: [userId], references: [id], onDelete: SetNull)
  coordinator     User?                     @relation("WorkProgramsCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  kpis            ExecutionKPI[]
  milestones      ExecutionMilestone[]
  tasks           ExecutionTask[]
  realizationLogs ExecutionRealizationLog[]
  evidence        ExecutionEvidence[]

  @@map("work_programs")
}

model ActivityReport {
  id            String     @id @default(uuid()) @db.Uuid
  departmentId  String     @map("department_id") @db.Uuid
  type          ReportType
  periodStart   DateTime   @map("period_start") @db.Date
  periodEnd     DateTime   @map("period_end") @db.Date
  content       String     @db.Text
  attachmentUrl String?    @map("attachment_url") @db.Text
  submittedById String     @map("submitted_by_id") @db.Uuid
  createdAt     DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  department  Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  submittedBy User       @relation("SubmittedActivityReports", fields: [submittedById], references: [id], onDelete: Cascade)

  @@map("activity_reports")
}

model ExecutionKPI {
  id              String             @id @default(uuid()) @db.Uuid
  programId       String             @map("program_id") @db.Uuid
  name            String             @db.VarChar(255)
  indicatorType   KPIIndicatorType   @map("indicator_type")
  direction       KPIDirection       @default(higher_is_better)
  baseline        Float              @default(0)
  baselineStatus  BaselineStatus     @default(draft) @map("baseline_status")
  target          Float              @default(0)
  realization     Float              @default(0)
  unit            String             @db.VarChar(50)
  weight          Float              @default(0)
  dataSource      String?            @map("data_source") @db.VarChar(255)
  updateFrequency KPIUpdateFrequency @default(monthly) @map("update_frequency")
  picId           String?            @map("pic_id") @db.Uuid
  notes           String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  program         WorkProgram               @relation(fields: [programId], references: [id], onDelete: Cascade)
  pic             User?                     @relation("ExecutionKPIPIC", fields: [picId], references: [id], onDelete: SetNull)
  evidences       ExecutionEvidence[]
  realizationLogs ExecutionRealizationLog[]
  milestones      ExecutionMilestone[]

  @@map("execution_kpis")
}

model ExecutionMilestone {
  id               String          @id @default(uuid()) @db.Uuid
  programId        String          @map("program_id") @db.Uuid
  order            Int             @default(1)
  name             String          @db.VarChar(255)
  output           String?         @db.Text
  weight           Float           @default(0)
  startDate        DateTime?       @map("start_date") @db.Date
  deadline         DateTime?       @db.Date
  actualEndDate    DateTime?       @map("actual_end_date") @db.Date
  picId            String?         @map("pic_id") @db.Uuid
  status           ExecutionStatus @default(not_started)
  progress         Float           @default(0)
  requiredEvidence String?         @map("required_evidence") @db.Text
  notes            String?         @db.Text
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  program        WorkProgram               @relation(fields: [programId], references: [id], onDelete: Cascade)
  pic            User?                     @relation("MilestonePIC", fields: [picId], references: [id], onDelete: SetNull)
  tasks          ExecutionTask[]
  logs           ExecutionRealizationLog[]
  evidence       ExecutionEvidence[]
  kpi            ExecutionKPI?             @relation(fields: [executionKPIId], references: [id])
  executionKPIId String?                   @db.Uuid

  @@map("execution_milestones")
}

model ExecutionTask {
  id                 String             @id @default(uuid()) @db.Uuid
  programId          String             @map("program_id") @db.Uuid
  milestoneId        String?            @map("milestone_id") @db.Uuid
  source             String?            @db.VarChar(100)
  referenceId        String?            @map("reference_id") @db.Uuid
  description        String             @db.Text
  expectedOutput     String?            @map("expected_output") @db.Text
  assignorId         String?            @map("assignor_id") @db.Uuid
  assigneeId         String?            @map("assignee_id") @db.Uuid
  delegationDate     DateTime           @default(now()) @map("delegation_date") @db.Date
  deadline           DateTime?          @db.Date
  priority           ExecutionPriority  @default(medium)
  status             ExecutionStatus    @default(not_started)
  progress           Float              @default(0)
  actualEndDate      DateTime?          @map("actual_end_date") @db.Date
  verifierId         String?            @map("verifier_id") @db.Uuid
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  verificationNotes  String?            @map("verification_notes") @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  program   WorkProgram         @relation(fields: [programId], references: [id], onDelete: Cascade)
  milestone ExecutionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  assignor  User?               @relation("TaskAssignor", fields: [assignorId], references: [id], onDelete: SetNull)
  assignee  User?               @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  verifier  User?               @relation("TaskVerifier", fields: [verifierId], references: [id], onDelete: SetNull)
  evidence  ExecutionEvidence[]

  @@map("execution_tasks")
}

model ExecutionRealizationLog {
  id                String   @id @default(uuid()) @db.Uuid
  programId         String   @map("program_id") @db.Uuid
  milestoneId       String?  @map("milestone_id") @db.Uuid
  kpiId             String?  @map("kpi_id") @db.Uuid
  activityDate      DateTime @map("activity_date") @db.Date
  activityName      String   @map("activity_name") @db.VarChar(255)
  location          String?  @db.VarChar(255)
  picId             String?  @map("pic_id") @db.Uuid
  participantCount  Int?     @default(0) @map("participant_count")
  output            String?  @db.Text
  budgetRef         String?  @map("budget_ref") @db.VarChar(255)
  issuesFound       String?  @map("issues_found") @db.Text
  recommendation    String?  @db.Text
  documentationLink String?  @map("documentation_link") @db.Text
  issueId           String?  @map("issue_id") @db.Uuid
  notes             String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  program   WorkProgram         @relation(fields: [programId], references: [id], onDelete: Cascade)
  milestone ExecutionMilestone? @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  kpi       ExecutionKPI?       @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  pic       User?               @relation("RealizationPIC", fields: [picId], references: [id], onDelete: SetNull)
  evidences ExecutionEvidence[]

  @@map("execution_realization_logs")
}

model ExecutionEvidence {
  id                 String             @id @default(uuid()) @db.Uuid
  programId          String             @map("program_id") @db.Uuid
  milestoneId        String?            @map("milestone_id") @db.Uuid
  taskId             String?            @map("task_id") @db.Uuid
  kpiId              String?            @map("kpi_id") @db.Uuid
  realizationLogId   String?            @map("realization_log_id") @db.Uuid
  name               String             @db.VarChar(255)
  type               EvidenceType       @default(document)
  nature             EvidenceNature     @default(mandatory)
  ownerId            String?            @map("owner_id") @db.Uuid
  physicalLocation   String?            @map("physical_location") @db.VarChar(255)
  digitalLink        String?            @map("digital_link") @db.Text
  availabilityStatus String?            @map("availability_status") @db.VarChar(100)
  documentDate       DateTime?          @map("document_date") @db.Date
  version            String?            @db.VarChar(50)
  quality            String?            @db.VarChar(100)
  verifierId         String?            @map("verifier_id") @db.Uuid
  verificationStatus VerificationStatus @default(unverified) @map("verification_status")
  verificationDate   DateTime?          @map("verification_date") @db.Timestamptz
  repairNeeded       String?            @map("repair_needed") @db.Text
  notes              String?            @db.Text
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime?          @updatedAt @map("updated_at") @db.Timestamptz

  program        WorkProgram              @relation(fields: [programId], references: [id], onDelete: Cascade)
  milestone      ExecutionMilestone?      @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  task           ExecutionTask?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  kpi            ExecutionKPI?            @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  realizationLog ExecutionRealizationLog? @relation(fields: [realizationLogId], references: [id], onDelete: Cascade)
  owner          User?                    @relation("EvidenceOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  verifier       User?                    @relation("EvidenceVerifier", fields: [verifierId], references: [id], onDelete: SetNull)

  @@map("execution_evidences")
}

model ExecutionIssue {
  id               String            @id @default(uuid()) @db.Uuid
  programId        String            @map("program_id") @db.Uuid
  milestoneId      String?           @map("milestone_id") @db.Uuid
  title            String            @db.VarChar(255)
  description      String            @db.Text
  impactScore      Int?              @map("impact_score") @db.SmallInt
  probabilityScore Int?              @map("probability_score") @db.SmallInt
  mitigationPlan   String?           @map("mitigation_plan") @db.Text
  status           ExecutionStatus   @default(not_started)
  priority         ExecutionPriority @default(medium)
  identifiedDate   DateTime          @default(now()) @map("identified_date") @db.Date
  resolvedDate     DateTime?         @map("resolved_date") @db.Date
  reporterId       String?           @map("reporter_id") @db.Uuid
  assigneeId       String?           @map("assignee_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?         @updatedAt @map("updated_at") @db.Timestamptz

  reporter    User?                 @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  assignee    User?                 @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  actionItems ExecutionActionItem[]

  @@map("execution_issues")
}

model ExecutionMeeting {
  id          String    @id @default(uuid()) @db.Uuid
  programId   String?   @map("program_id") @db.Uuid
  title       String    @db.VarChar(255)
  agenda      String    @db.Text
  meetingDate DateTime  @map("meeting_date") @db.Timestamptz
  location    String?   @db.VarChar(255)
  organizerId String?   @map("organizer_id") @db.Uuid
  notes       String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  attendances MeetingAttendance[]
  actionItems ExecutionActionItem[]

  @@map("execution_meetings")
}

model MeetingAttendance {
  id        String           @id @default(uuid()) @db.Uuid
  meetingId String           @map("meeting_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    AttendanceStatus
  notes     String?          @db.VarChar(255)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime?        @updatedAt @map("updated_at") @db.Timestamptz

  meeting ExecutionMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("meeting_attendances")
}

model ExecutionActionItem {
  id          String          @id @default(uuid()) @db.Uuid
  meetingId   String?         @map("meeting_id") @db.Uuid
  issueId     String?         @map("issue_id") @db.Uuid
  description String          @db.Text
  picId       String?         @map("pic_id") @db.Uuid
  deadline    DateTime?       @db.Date
  status      ExecutionStatus @default(not_started)
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime?       @updatedAt @map("updated_at") @db.Timestamptz

  meeting ExecutionMeeting? @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  issue   ExecutionIssue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  pic     User?             @relation("ActionItemPIC", fields: [picId], references: [id], onDelete: SetNull)

  @@map("execution_action_items")
}
