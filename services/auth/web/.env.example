# Public Admin URL consumed only by Auth server components.
# In Coolify production, set this to https://admin.alfida.or.id.
ADMIN_PUBLIC_API_URL="https://admin.alfida.or.id"
# Set only after an explicitly verified private Admin service URL is available.
# Do not use 127.0.0.1: Auth and Admin run in separate containers.
INTERNAL_ADMIN_API_URL=""
