# SIYAUM YMQ deployment configuration
# Copy keys into the SIYAUM Coolify application. Never commit real credentials.

# API database (runtime)
DATABASE_URL="postgresql://USER:PASSWORD@POSTGRES_HOST:5432/siyaum?schema=public"

# SIYAUM API → Auth YMQ role broker (runtime)
AUTH_INTERNAL_API_URL="https://auth.example.test"
INTERNAL_SERVICE_SECRET="replace-with-the-shared-high-entropy-service-secret"

# SIYAUM API → SIMPEG employee/unit projection (runtime)
SIMPEG_INTERNAL_API_URL="https://simpeg.example.test"

# Cloudinary evidence validation (API runtime)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
YMQ_EVIDENCE_MAX_BYTES="10000000"

# Same-container Next.js → Nest API rewrite (runtime)
INTERNAL_API_URL="http://127.0.0.1:3001"

# Browser-visible configuration (Coolify build-time)
NEXT_PUBLIC_AUTH_URL="https://auth.example.test"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_YMQ_UPLOAD_PRESET="ymq_unsigned"
