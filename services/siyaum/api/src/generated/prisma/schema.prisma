datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum SetoranType {
  tilawah
  ziyadah
  murojaah
}

enum VerificationStatus {
  pending
  verified
  revision
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(200)
  username  String?  @unique @db.VarChar(100)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  avatarUrl String?  @map("avatar_url") @db.Text
  unitName  String?  @map("unit_name") @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  groupsAsMusyrif  YmqGroup[]
  memberships      YmqMember[]
  setoranList      YmqSetoran[] @relation("UserSetoran")
  verifiedSetorans YmqSetoran[] @relation("MusyrifVerifications")
  targets          YmqTarget[]

  @@map("users")
}

model YmqGroup {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(200)
  musyrifId    String   @map("musyrif_id") @db.Uuid
  description  String?  @db.Text
  scheduleDay  String?  @map("schedule_day") @db.VarChar(30)
  scheduleTime String?  @map("schedule_time") @db.VarChar(50)
  whatsappLink String?  @map("whatsapp_link") @db.VarChar(255)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  musyrif User        @relation(fields: [musyrifId], references: [id], onDelete: Restrict)
  members YmqMember[]

  @@map("ymq_groups")
}

model YmqMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz

  group YmqGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("ymq_members")
}

model YmqSetoran {
  id               String             @id @default(uuid()) @db.Uuid
  userId           String             @map("user_id") @db.Uuid
  date             DateTime           @db.Date
  jenis            SetoranType        @default(tilawah)
  surahMulai       String             @map("surah_mulai") @db.VarChar(100)
  ayatMulai        Int                @map("ayat_mulai")
  surahSelesai     String             @map("surah_selesai") @db.VarChar(100)
  ayatSelesai      Int                @map("ayat_selesai")
  jumlahHalaman    Int                @default(1) @map("jumlah_halaman")
  catatan          String?            @db.Text
  statusVerifikasi VerificationStatus @default(pending) @map("status_verifikasi")
  catatanMusyrif   String?            @map("catatan_musyrif") @db.Text
  verifiedById     String?            @map("verified_by_id") @db.Uuid
  verifiedAt       DateTime?          @map("verified_at") @db.Timestamptz
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz

  user       User  @relation("UserSetoran", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy User? @relation("MusyrifVerifications", fields: [verifiedById], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([statusVerifikasi])
  @@map("ymq_setoran")
}

model YmqTarget {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  periodeBulan     Int      @map("periode_bulan")
  periodeTahun     Int      @map("periode_tahun")
  targetKhatam     Int      @default(1) @map("target_khatam") // Berapa kali khatam dalam periode
  targetHafalanJuz Int      @default(0) @map("target_hafalan_juz") // Tambahan juz hafalan
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodeBulan, periodeTahun])
  @@map("ymq_targets")
}
