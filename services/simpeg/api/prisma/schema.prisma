datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum GpsAttendanceStatus {
  present
  late
  absent
  leave
}

enum LeaveType {
  cuti
  sakit
  izin
}

enum LeaveStatus {
  pending
  approved
  rejected
}

enum DayOfWeek {
  monday
  tuesday
  wednesday
  thursday
  friday
  saturday
}

enum AttendanceStatus {
  present
  sick
  permitted
  absent
}

enum DepartmentAdminRole {
  admin_bidang
}

enum OrganizationSyncAggregate {
  department
  department_member
  unit
  user
}

enum OrganizationSyncStatus {
  pending
  processing
  delivered
  failed
}

enum AuthRoleCompensationScope {
  unit
  department
}

enum AuthRoleCompensationStatus {
  armed
  pending
  processing
  delivered
  failed
}

model User {
  id         String   @id @default(uuid()) @db.Uuid
  fullName   String   @map("full_name") @db.VarChar(200)
  username   String?  @unique @db.VarChar(100)
  email      String   @unique @db.VarChar(255)
  phone      String?  @db.VarChar(30)
  avatarUrl  String?  @map("avatar_url") @db.Text
  leaveQuota Int      @default(12) @map("leave_quota")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  profile             EmployeeProfile?
  unitAssignments     EmployeeUnitAssignment[]
  gpsAttendances      GpsAttendance[]
  leaveRequests       LeaveRequest[]           @relation("UserLeaveRequests")
  approvedLeaves      LeaveRequest[]           @relation("ApprovedLeaves")
  liqoGroupsAsMurobbi LiqoGroup[]
  liqoMemberships     LiqoMember[]
  liqoAttendances     LiqoAttendance[]
  mutabaahRecords     MutabaahRecord[]
  departmentsLed      Department[]           @relation("DepartmentLeader")
  departmentMembers   DepartmentMember[]

  @@map("users")
}

model EmployeeProfile {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @unique @map("user_id") @db.Uuid
  nip          String?   @unique @db.VarChar(50)
  position     String?   @db.VarChar(100)
  employeeType String    @default("tetap") @map("employee_type") @db.VarChar(50) // "tetap", "kontrak", "honorer"
  joinDate     DateTime? @map("join_date") @db.Date
  notes        String?   @db.Text
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

model Unit {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @db.VarChar(150)
  code      String    @unique @db.VarChar(50)
  category  String    @default("pendidikan") @db.VarChar(30) // pendidikan | nondik
  address   String?   @db.Text
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  departments Department[]

  @@map("units")
}

model Department {
  id          String    @id @default(uuid()) @db.Uuid
  unitId      String?   @map("unit_id") @db.Uuid
  name        String    @unique @db.VarChar(150)
  code        String    @unique @db.VarChar(50)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz
  parentId    String?   @map("parent_id") @db.Uuid
  leaderId    String?   @map("leader_id") @db.Uuid

  unit     Unit?              @relation(fields: [unitId], references: [id], onDelete: SetNull)
  parent   Department?        @relation("DepartmentHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[]       @relation("DepartmentHierarchy")
  leader   User?              @relation("DepartmentLeader", fields: [leaderId], references: [id], onDelete: SetNull)
  members  DepartmentMember[]

  @@index([unitId])
  @@index([parentId])
  @@index([leaderId])
  @@map("departments")
}

model DepartmentMember {
  id              String    @id @default(uuid()) @db.Uuid
  departmentId    String    @map("department_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  role            String?   @db.VarChar(50)
  sourceCreatedAt DateTime? @map("source_created_at") @db.Timestamptz
  sourceUpdatedAt DateTime  @map("source_updated_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([departmentId, userId])
  @@index([userId])
  @@index([sourceUpdatedAt])
  @@map("department_members")
}

model OrganizationImportReceipt {
  id            String   @id @default(uuid()) @db.Uuid
  source        String   @db.VarChar(80)
  entity        String   @db.VarChar(80)
  sourceId      String   @map("source_id") @db.VarChar(200)
  payloadHash   String   @map("payload_hash") @db.VarChar(64)
  sourceVersion DateTime @map("source_version") @db.Timestamptz
  appliedAt     DateTime @default(now()) @map("applied_at") @db.Timestamptz
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([source, entity, sourceId])
  @@index([source, entity, sourceVersion])
  @@map("organization_import_receipts")
}

model DepartmentAdminAssignment {
  id               String              @id @default(uuid()) @db.Uuid
  departmentId     String              @map("department_id") @db.Uuid
  userId           String              @map("user_id") @db.Uuid
  role             DepartmentAdminRole @default(admin_bidang)
  isActive         Boolean             @default(true) @map("is_active")
  assignedById     String              @map("assigned_by_id") @db.Uuid
  assignedAt       DateTime            @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime?           @map("revoked_at") @db.Timestamptz
  revokedById      String?             @map("revoked_by_id") @db.Uuid
  authAssignmentId String?             @map("auth_assignment_id") @db.Uuid

  @@unique([departmentId, userId, role])
  @@index([departmentId, isActive])
  @@index([userId, isActive])
  @@map("department_admin_assignments")
}

model UnitAdminAssignment {
  id               String   @id @default(uuid()) @db.Uuid
  unitId           String   @map("unit_id") @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  app              String   @db.VarChar(30)
  role             String   @db.VarChar(50)
  isActive         Boolean  @default(true) @map("is_active")
  assignedById     String   @map("assigned_by_id") @db.Uuid
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  revokedById      String?  @map("revoked_by_id") @db.Uuid
  authAssignmentId String?  @map("auth_assignment_id") @db.Uuid

  @@unique([unitId, userId, app, role])
  @@index([unitId, isActive])
  @@index([userId, isActive])
  @@map("unit_admin_assignments")
}

model OrganizationSyncOutbox {
  id             String                   @id @default(uuid()) @db.Uuid
  aggregate      OrganizationSyncAggregate
  aggregateId    String                   @map("aggregate_id") @db.Uuid
  eventType      String                   @map("event_type") @db.VarChar(80)
  payload        Json
  idempotencyKey String                   @unique @map("idempotency_key") @db.VarChar(180)
  status         OrganizationSyncStatus   @default(pending)
  attemptCount   Int                      @default(0) @map("attempt_count")
  lastError      String?                  @map("last_error") @db.Text
  availableAt    DateTime                 @default(now()) @map("available_at") @db.Timestamptz
  deliveredAt    DateTime?                @map("delivered_at") @db.Timestamptz
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, availableAt])
  @@index([aggregate, aggregateId])
  @@map("organization_sync_outbox")
}

model AuthRoleCompensation {
  id                String                     @id @default(uuid()) @db.Uuid
  localAssignmentId String                     @unique @map("local_assignment_id") @db.Uuid
  scope             AuthRoleCompensationScope
  userId            String                     @map("user_id") @db.Uuid
  scopeId           String                     @map("scope_id") @db.Uuid
  app               String                     @db.VarChar(30)
  role              String                     @db.VarChar(50)
  requestedById     String?                    @map("requested_by_id") @db.Uuid
  authAssignmentId  String?                    @map("auth_assignment_id") @db.Uuid
  idempotencyKey    String                     @unique @map("idempotency_key") @db.VarChar(220)
  status            AuthRoleCompensationStatus @default(armed)
  attemptCount      Int                        @default(0) @map("attempt_count")
  lastError         String?                    @map("last_error") @db.Text
  availableAt       DateTime                   @default(now()) @map("available_at") @db.Timestamptz
  deliveredAt       DateTime?                  @map("delivered_at") @db.Timestamptz
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime                   @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status, availableAt])
  @@map("auth_role_compensations")
}

model EmployeeUnitAssignment {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  unitId    String    @map("unit_id") @db.Uuid
  unitName  String    @map("unit_name") @db.VarChar(150)
  role      String    @db.VarChar(50) // "guru_kelas", "guru_mapel", "staff_tu", "kepala_unit"
  isPrimary Boolean   @default(true) @map("is_primary")
  startDate DateTime  @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  skNumber  String?   @map("sk_number") @db.VarChar(100)
  notes     String?   @db.Text
  sourceKey String?   @unique @map("source_key") @db.VarChar(120)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([unitId])
  @@map("employee_unit_assignments")
}

model GpsAttendanceConfig {
  id           String   @id @default(uuid()) @db.Uuid
  unitId       String   @unique @map("unit_id") @db.Uuid
  latitude     Float
  longitude    Float
  radiusMeters Int      @default(50) @map("radius_meters")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("gps_attendance_config")
}

model UnitWorkSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  unitId            String   @map("unit_id") @db.Uuid
  weekday           Int
  isWorkday         Boolean  @default(false) @map("is_workday")
  startTime         String?  @map("start_time") @db.VarChar(5)
  lateGraceMinutes  Int?     @map("late_grace_minutes")
  endTime           String?  @map("end_time") @db.VarChar(5)
  overtimeStartTime String?  @map("overtime_start_time") @db.VarChar(5)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([unitId, weekday])
  @@index([unitId])
  @@map("unit_work_schedules")
}

model GpsAttendance {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @map("user_id") @db.Uuid
  unitId       String              @map("unit_id") @db.Uuid
  date         DateTime            @db.Date
  checkInTime  DateTime?           @map("check_in_time") @db.Timestamptz
  checkOutTime DateTime?           @map("check_out_time") @db.Timestamptz
  workScheduleSnapshot Json?       @map("work_schedule_snapshot") @db.JsonB
  overtimeMinutes Int              @default(0) @map("overtime_minutes")
  latitude     Float?
  longitude    Float?
  status       GpsAttendanceStatus
  notes        String?
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@index([status])
  @@map("gps_attendances")
}

model Holiday {
  id               String    @id @default(uuid()) @db.Uuid
  unitId           String?   @map("unit_id") @db.Uuid
  date             DateTime  @db.Date
  name             String    @db.VarChar(100)
  description      String?
  source           String    @default("manual") @db.VarChar(16)
  providerKey      String?   @unique @map("provider_key") @db.VarChar(160)
  providerSyncedAt DateTime? @map("provider_synced_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@unique([unitId, date])
  @@index([date])
  @@map("holidays")
}

model SaturdayDutyAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  startTime         String? @map("start_time") @db.VarChar(5)
  lateGraceMinutes  Int?    @map("late_grace_minutes")
  endTime           String? @map("end_time") @db.VarChar(5)
  overtimeStartTime String? @map("overtime_start_time") @db.VarChar(5)
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([unitId, userId, date])
  @@index([unitId, date])
  @@index([userId, date])
  @@map("saturday_duty_assignments")
}

model LeaveRequest {
  id            String      @id @default(uuid()) @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  type          LeaveType
  startDate     DateTime    @map("start_date") @db.Date
  endDate       DateTime    @map("end_date") @db.Date
  reason        String      @db.Text
  attachmentUrl String?     @map("attachment_url") @db.Text
  status        LeaveStatus @default(pending)
  approvedById  String?     @map("approved_by_id") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime?   @updatedAt @map("updated_at") @db.Timestamptz

  user       User  @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("ApprovedLeaves", fields: [approvedById], references: [id], onDelete: SetNull)

  @@map("leave_requests")
}

model LiqoGroup {
  id               String     @id @default(uuid()) @db.Uuid
  name             String     @db.VarChar(200)
  murobbiId        String     @map("murobbi_id") @db.Uuid
  description      String?
  scheduleDay      DayOfWeek? @map("schedule_day")
  scheduleTime     String?    @map("schedule_time") @db.VarChar(50)
  scheduleLocation String?    @map("schedule_location") @db.VarChar(200)
  whatsappLink     String?    @map("whatsapp_link") @db.VarChar(255)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  murobbi  User          @relation(fields: [murobbiId], references: [id], onDelete: Restrict)
  members  LiqoMember[]
  meetings LiqoMeeting[]

  @@map("liqo_groups")
}

model LiqoMember {
  id       String   @id @default(uuid()) @db.Uuid
  groupId  String   @map("group_id") @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz

  group LiqoGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("liqo_members")
}

model LiqoMeeting {
  id            String    @id @default(uuid()) @db.Uuid
  groupId       String    @map("group_id") @db.Uuid
  date          DateTime  @db.Date
  materialTitle String    @map("material_title") @db.VarChar(200)
  summary       String?   @db.Text
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  group       LiqoGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendances LiqoAttendance[]

  @@map("liqo_meetings")
}

model LiqoAttendance {
  id        String           @id @default(uuid()) @db.Uuid
  meetingId String           @map("meeting_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  status    AttendanceStatus
  notes     String?          @db.VarChar(255)
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime?        @updatedAt @map("updated_at") @db.Timestamptz

  meeting LiqoMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@map("liqo_attendances")
}

model MutabaahRecord {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  date          DateTime  @db.Date
  sholatJamaah  Int       @default(0) @map("sholat_jamaah")
  sholatRawatib Int       @default(0) @map("sholat_rawatib")
  sholatDhuha   Boolean   @default(false) @map("sholat_dhuha")
  sholatTahajud Boolean   @default(false) @map("sholat_tahajud")
  tilawahPages  Int       @default(0) @map("tilawah_pages")
  puasaSunnah   Boolean   @default(false) @map("puasa_sunnah")
  infaq         Boolean   @default(false)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([date])
  @@map("mutabaah_records")
}
