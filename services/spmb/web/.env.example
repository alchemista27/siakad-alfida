# URL public Admin API used by SPMB server components to load foundation logo/favicon.
ADMIN_PUBLIC_API_URL="https://admin.alfida.or.id"
# Use only a verified private Admin URL. Leave blank when unavailable.
INTERNAL_ADMIN_API_URL=""
# Auth API read by SPMB's same-origin /api/sso/me proxy.
AUTH_PUBLIC_API_URL="https://auth.alfida.or.id"
# Use only a verified private Auth URL. Leave blank when unavailable.
INTERNAL_AUTH_API_URL=""
