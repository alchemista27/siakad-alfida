datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

enum RegistrationSource {
  online
  offline
}

enum RegistrationStatus {
  pending_payment
  payment_uploaded
  payment_verified
  form_filling
  documents_uploaded
  medical_pending
  medical_uploaded
  verification
  observation_scheduled
  observation_done
  accepted
  rejected
  enrolled
}

enum HandoffStatus {
  not_ready
  pending
  done
  failed
}

enum DossierReviewStatus {
  pending
  approved
  revision_required
}

enum PaymentMethod {
  transfer_proof
  offline
}

enum PaymentStatus {
  pending
  uploaded
  verified
  rejected
}

enum Gender {
  male
  female
}

enum ParentType {
  father
  mother
  guardian
}

enum DocumentType {
  photo
  school_certificate
  birth_certificate
  family_card
  father_id
  mother_id
  medical_result
}

model AdmissionPeriod {
  id                   String    @id @default(uuid()) @db.Uuid
  unitId               String    @map("unit_id") @db.Uuid
  sourceAcademicYearId String?   @map("source_academic_year_id") @db.Uuid
  unitName             String    @map("unit_name") @db.VarChar(200)
  unitSlug   String    @map("unit_slug") @db.VarChar(100)
  label      String    @db.VarChar(50) // contoh: 2026/2027
  isOpen     Boolean   @default(true) @map("is_open")
  quota      Int       @default(60)
  fee        Int       @default(250000)
  bankName   String?   @map("bank_name") @db.VarChar(100)
  bankNumber String?   @map("bank_number") @db.VarChar(50)
  bankHolder String?   @map("bank_holder") @db.VarChar(200)
  opensAt    DateTime? @map("opens_at") @db.Date
  closesAt   DateTime? @map("closes_at") @db.Date
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  registrations Registration[]
  schedules     ObservationSchedule[]
  counter       AdmissionPeriodCounter?

  @@unique([unitId, label])
  @@index([isOpen])
  @@map("admission_periods")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(200)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(30)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  registrations     Registration[]      @relation("ParentRegistrations")
  observationResult ObservationResult[]

  @@map("users")
}

model Registration {
  id                 String             @id @default(uuid()) @db.Uuid
  registrationNumber String             @unique @map("registration_number") @db.VarChar(50)
  periodId           String             @map("period_id") @db.Uuid
  source             RegistrationSource @default(online)
  externalRef        String?            @map("external_ref") @db.VarChar(100)
  status              RegistrationStatus  @default(pending_payment)
  dossierReviewStatus DossierReviewStatus @default(pending) @map("dossier_review_status")
  rejectionReason     String?             @map("rejection_reason") @db.Text

  parentId        String?   @map("parent_id") @db.Uuid
  guardianName    String?   @map("guardian_name") @db.VarChar(200)
  guardianPhone   String?   @map("guardian_phone") @db.VarChar(30)
  guardianEmail   String?   @map("guardian_email") @db.VarChar(255)
  inviteToken     String?   @unique @map("invite_token") @db.VarChar(100)
  inviteExpiresAt DateTime? @map("invite_expires_at") @db.Timestamptz
  claimedAt       DateTime? @map("claimed_at") @db.Timestamptz

  handoffStatus HandoffStatus @default(not_ready) @map("handoff_status")
  handoffError  String?       @map("handoff_error") @db.Text
  handoffAt     DateTime?     @map("handoff_at") @db.Timestamptz

  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  period             AdmissionPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  parent             User?               @relation("ParentRegistrations", fields: [parentId], references: [id], onDelete: SetNull)
  payment            Payment?
  studentData        StudentData?
  parentData         ParentData[]
  documents          Document[]
  medicalReferral    MedicalReferral?
  observationBooking ObservationBooking?
  observationResult  ObservationResult?
  events             RegistrationEvent[]
  handoffOutbox      HandoffOutbox?

  @@unique([periodId, externalRef])
  @@index([periodId, status])
  @@index([parentId])
  @@map("registrations")
}

model RegistrationEvent {
  id             String              @id @default(uuid()) @db.Uuid
  registrationId String              @map("registration_id") @db.Uuid
  actorId        String?             @map("actor_id") @db.Uuid
  fromStatus     RegistrationStatus? @map("from_status")
  toStatus       RegistrationStatus  @map("to_status")
  kind           String              @db.VarChar(50) // transition | backfill | claim | handoff | import
  note           String?             @db.Text
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@index([registrationId, createdAt])
  @@map("registration_events")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  registrationId String        @unique @map("registration_id") @db.Uuid
  amount         Decimal       @db.Decimal(12, 2)
  proofUrl       String?       @map("proof_url") @db.Text
  proofObjectKey String?       @map("proof_object_key") @db.Text
  proofFileName  String?       @map("proof_file_name") @db.VarChar(255)
  proofFileSize  Int?          @map("proof_file_size")
  proofMimeType  String?       @map("proof_mime_type") @db.VarChar(100)
  method         PaymentMethod @default(transfer_proof)
  status         PaymentStatus @default(pending)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz
  uploadedAt     DateTime?     @map("uploaded_at") @db.Timestamptz
  verifiedAt     DateTime?     @map("verified_at") @db.Timestamptz
  verifiedBy     String?       @map("verified_by") @db.Uuid
  rejectionNote  String?       @map("rejection_note") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model StudentData {
  id             String    @id @default(uuid()) @db.Uuid
  registrationId String    @unique @map("registration_id") @db.Uuid
  fullName       String    @map("full_name") @db.VarChar(200)
  nickname       String?   @db.VarChar(100)
  gender         Gender
  religion       String    @default("Islam") @db.VarChar(50)
  birthPlace     String    @map("birth_place") @db.VarChar(100)
  birthDate      DateTime  @map("birth_date") @db.Date
  nisn           String?   @db.VarChar(20)
  siblingsCount  Int       @default(0) @map("siblings_count")
  address        String    @db.Text
  transportation String?   @db.VarChar(100)
  hobby          String?   @db.VarChar(100)
  ambition       String?   @db.VarChar(100)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("student_data")
}

model ParentData {
  id             String     @id @default(uuid()) @db.Uuid
  registrationId String     @map("registration_id") @db.Uuid
  type           ParentType
  fullName       String     @map("full_name") @db.VarChar(200)
  nik            String?    @db.VarChar(20)
  birthPlace     String?    @map("birth_place") @db.VarChar(100)
  birthDate      DateTime?  @map("birth_date") @db.Date
  education      String?    @db.VarChar(50)
  occupation     String?    @db.VarChar(100)
  phone          String?    @db.VarChar(30)
  incomeRange    String?    @map("income_range") @db.VarChar(50)
  address        String?    @db.Text
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime?  @updatedAt @map("updated_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@unique([registrationId, type])
  @@map("parent_data")
}

model Document {
  id             String       @id @default(uuid()) @db.Uuid
  registrationId String       @map("registration_id") @db.Uuid
  type           DocumentType
  objectKey      String       @map("object_key") @db.Text
  fileName       String       @map("file_name") @db.VarChar(255)
  fileSize       Int          @map("file_size")
  mimeType       String       @map("mime_type") @db.VarChar(100)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model MedicalReferral {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  referralNumber String   @unique @map("referral_number") @db.VarChar(50)
  pdfUrl         String?  @map("pdf_url") @db.Text
  resultFileUrl  String?  @map("result_file_url") @db.Text
  issuedAt       DateTime @default(now()) @map("issued_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)

  @@map("medical_referrals")
}

model ObservationSchedule {
  id        String   @id @default(uuid()) @db.Uuid
  periodId  String   @map("period_id") @db.Uuid
  date      DateTime @db.Date
  startTime String   @map("start_time") @db.VarChar(10)
  endTime   String   @map("end_time") @db.VarChar(10)
  quota     Int      @default(15)
  booked    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  period   AdmissionPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  bookings ObservationBooking[]

  @@map("observation_schedules")
}

model ObservationBooking {
  id                    String   @id @default(uuid()) @db.Uuid
  registrationId        String   @unique @map("registration_id") @db.Uuid
  observationScheduleId String   @map("observation_schedule_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  registration Registration        @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  schedule     ObservationSchedule @relation(fields: [observationScheduleId], references: [id], onDelete: Cascade)

  @@map("observation_bookings")
}

model ObservationResult {
  id             String   @id @default(uuid()) @db.Uuid
  registrationId String   @unique @map("registration_id") @db.Uuid
  observerId     String   @map("observer_id") @db.Uuid
  score          Decimal  @db.Decimal(5, 2)
  notes          String?  @db.Text
  rank           Int?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  observer     User         @relation(fields: [observerId], references: [id], onDelete: Restrict)

  @@map("observation_results")
}

model SpmbObserver {
  id        String   @id @default(uuid()) @db.Uuid
  unitId    String   @map("unit_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([unitId, userId])
  @@map("spmb_observers")
}

model AdmissionPeriodCounter {
  periodId       String @id @map("period_id") @db.Uuid
  nextSequence   Int    @default(1) @map("next_sequence")
  intakeReserved Int    @default(0) @map("intake_reserved")
  acceptedCount  Int    @default(0) @map("accepted_count")

  period AdmissionPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  @@map("admission_period_counters")
}

model HandoffOutbox {
  id                      String    @id @default(uuid()) @db.Uuid
  registrationId          String    @unique @map("registration_id") @db.Uuid
  idempotencyKey          String    @unique @map("idempotency_key") @db.Uuid
  payloadHash             String    @map("payload_hash") @db.VarChar(128)
  status                  String    @default("pending") @db.VarChar(30)
  attempts                Int       @default(0)
  availableAt             DateTime  @default(now()) @map("available_at") @db.Timestamptz
  leasedAt                DateTime? @map("leased_at") @db.Timestamptz
  leaseOwner              String?   @map("lease_owner") @db.VarChar(100)
  lastError               String?   @map("last_error") @db.Text
  destinationEnrollmentId String?   @map("destination_enrollment_id") @db.Uuid
  deliveredAt             DateTime? @map("delivered_at") @db.Timestamptz
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime? @updatedAt @map("updated_at") @db.Timestamptz

  registration Registration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
  @@index([status, leasedAt])
  @@map("handoff_outbox")
}
