{
  "name": "siakad-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm run db:generate && nest build && cp -r src/generated dist/",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "typecheck": "pnpm run db:generate && tsc --noEmit",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@alfida/auth-sdk": "workspace:*",
    "@alfida/contracts": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/client": "^6.1.0",
    "cookie-parser": "^1.4.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
