# Database Connection (VPS Coolify)
DATABASE_URL="postgresql://user:password@vps-ip-or-domain:5432/db_name"
DIRECT_URL="postgresql://user:password@vps-ip-or-domain:5432/db_name"

# Supabase Auth Configuration
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# Cloudinary Config
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"

# MinIO / S3 Configuration
MINIO_ENDPOINT="https://s3.alfida.or.id"
MINIO_PUBLIC_URL="https://s3.alfida.or.id"
MINIO_ACCESS_KEY="minio_access_key_here"
MINIO_SECRET_KEY="minio_secret_key_here"
MINIO_BUCKET="sim-alfida"

S3_ENDPOINT="https://s3.alfida.or.id"
S3_ACCESS_KEY="minio_access_key_here"
S3_SECRET_KEY="minio_secret_key_here"
S3_BUCKET="sim-alfida-uploads"
