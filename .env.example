# Database Connection
DATABASE_URL="postgresql://postgres:password@localhost:5432/simalfida"
DIRECT_URL="postgresql://postgres:password@localhost:5432/simalfida"

# MinIO / S3 Configuration
MINIO_ENDPOINT="http://s3.localhost"
MINIO_PUBLIC_URL="http://s3.localhost"
MINIO_ACCESS_KEY="your-minio-access-key"
MINIO_SECRET_KEY="your-minio-secret-key"
MINIO_BUCKET="sim-alfida"

S3_ENDPOINT="https://s3.localhost"
S3_PUBLIC_ENDPOINT="https://s3.localhost"
S3_ACCESS_KEY="your-s3-access-key"
S3_SECRET_KEY="your-s3-secret-key"
S3_BUCKET="sim-alfida-uploads"

# Better Auth
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# SIAKAD / SIMPEG internal organization projection
# Set the same high-entropy value in SIAKAD INTERNAL_SERVICE_TOKEN and SIMPEG INTERNAL_SERVICE_TOKEN.
# Never commit a real token; Coolify owns the production values.
SIAKAD_API_URL="https://siakad.example.test"
INTERNAL_SERVICE_TOKEN="replace-with-a-shared-high-entropy-token"

# SIAKAD SPP payment menu — SISKEU is the authoritative issuer of invoices.
# SISKEU must expose the internal list/payment-session contract to SIAKAD.
# Use the same high-entropy service credential configured by SISKEU; never expose it to the browser.
SISKEU_API_URL="https://siskeu.example.test"
SISKEU_INTERNAL_SERVICE_TOKEN="replace-with-siskeu-internal-service-token"

# Browser-visible SIAKAD unit identity uploads (build-time in Next.js)
NEXT_PUBLIC_AUTH_URL="https://auth.example.test"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
NEXT_PUBLIC_CLOUDINARY_UNIT_UPLOAD_PRESET="alfida_unsigned"
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET="alfida_unsigned"
